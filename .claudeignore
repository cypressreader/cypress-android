# Never index or read these: they cost tokens and carry no information I need.
# (Claude Code itself enforces this through the "deny" list in .claude/settings.json; keep the two in step.)

# dependencies and lockfiles
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# build output
dist/
build/
.gradle/
android/app/build/

# minified files and sourcemaps
*.min.js
*.min.css
*.map

# generated or duplicate copies of www/index.html (edit www/index.html; hooks regenerate these)
docs/app/index.html
docs/demo.html
context/

# old site backup and screenshots
backup/
*.png
*.jpg
*.jpeg
