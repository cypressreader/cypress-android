+ const fin=await p.evaluate(()=>{const n=document.querySelector('.rfoot .rf-next');return n?n.textContent:''});
+ ck('the end card offers the next chapter',/Two: The Middle/.test(fin),fin);
+ await p.evaluate(()=>go(1));await p.waitForTimeout(400);
+ ck('the first turn past the end says next chapter',await p.evaluate(()=>/next chapter/.test(($('#rnh')||{}).textContent||'')));
+ await p.evaluate(()=>go(1));await p.waitForTimeout(2500);
+ const n2=await p.evaluate(()=>({link:curA.link,pg:R.pg,np:R.np,bp:S.bpos[curA.book],text:/Chapter 2 paragraph 0/.test(document.querySelector('.cols .body').textContent)}));
