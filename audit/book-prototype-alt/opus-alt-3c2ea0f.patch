+ ck('a page turn moves on one page',t.pg===1,JSON.stringify(t));
+ ck('the place is saved as chapter + fraction',t.bp&&t.bp.c===0&&t.bp.f>0&&t.bp.f<1,JSON.stringify(t.bp));
