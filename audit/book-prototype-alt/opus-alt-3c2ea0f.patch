+/* Books prototype (phase 0): a tiny EPUB made in the test (stored ZIP entries, built with the app's own zipStore) is opened through the Books shelf's file picker.
+   Checks: the side panel row, the shelf and contents, the gentle cleaner (no scripts or handlers), a very long chapter split in two, chapter 1 opening with no network,
+   a page turn, the end of chapter 1 going on to chapter 2, and the saved position (chapter + fraction) surviving a reload. Paged mode at 390x844. */
+const {APP}=require('./env');const {mock,PW}=require('./mock');const {chromium}=require(PW);
+let bad=0;const ck=(n,ok,x)=>{if(!ok){bad++;console.log('FAIL',n,x||'')}else console.log('ok',n)};
+(async()=>{
+ const b=await chromium.launch();const ctx=await b.newContext({viewport:{width:390,height:844}});const p=await ctx.newPage();
+ const errs=[],bookReq=[];p.on('pageerror',e=>errs.push(e.message));p.on('request',r=>{if(/book:|bk-|\.xhtml/.test(r.url()))bookReq.push(r.url())});
+ await mock(p,{n:6});await p.goto('file://'+APP);await p.waitForTimeout(1200);await p.click('text=Get started').catch(()=>{});await p.waitForTimeout(300);
+ /* the shelf is hidden until the switch is on or a book exists */
+ const hidden=await p.evaluate(()=>{document.querySelectorAll('dialog[open]').forEach(d=>d.close());S.scroll='pages';S.folio=true;render();return !document.querySelector('[data-sel="books"]')});
+ ck('no Books row for someone without books',hidden);
+ const bytes=await p.evaluate(()=>{
+  const para=(c,k)=>'<p>Chapter '+c+' paragraph '+k+'. '+'The sea was calm and the long voyage went on, day after day, under a pale and patient sky. '.repeat(4)+'</p>';
+  const xh=(t,body)=>'<?xml version="1.0" encoding="utf-8"?><html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" lang="en"><head><title>'+t+'</title><script>window.__bad=1</script></head><body>'+body+'</body></html>';
+  const ch1=xh('One','<section id="c1"><h2>Chapter One</h2>'+Array.from({length:40},(_,k)=>para(1,k)).join('')+'<p onclick="window.__bad=2">See <a href="ch2.xhtml#end2" epub:type="noteref">the note<sup>1</sup></a>.</p><form><input name="x"/></form><iframe src="https://x.test/"></iframe></section>');
+  const ch2=xh('Two','<section><h2>Chapter Two</h2>'+Array.from({length:30},(_,k)=>para(2,k)).join('')+'<p id="end2">The end of two.</p></section>');
+  const ch3=xh('Three','<section><h2>Chapter Three</h2>'+Array.from({length:160},(_,k)=>para(3,k)).join('')+'</section>');
+  const opf='<?xml version="1.0"?><package xmlns="http://www.idpf.org/2007/opf" version="3.0" unique-identifier="uid"><metadata xmlns:dc="http://purl.org/dc/elements/1.1/"><dc:identifier id="uid">urn:test:book-proto</dc:identifier><dc:title>A Test Voyage</dc:title><dc:creator>Ann Author</dc:creator><dc:language>en</dc:language></metadata><manifest><item id="nav" href="nav.xhtml" media-type="application/xhtml+xml" properties="nav"/><item id="c1" href="ch1.xhtml" media-type="application/xhtml+xml"/><item id="c2" href="ch2.xhtml" media-type="application/xhtml+xml"/><item id="c3" href="ch3.xhtml" media-type="application/xhtml+xml"/></manifest><spine><itemref idref="c1"/><itemref idref="c2"/><itemref idref="c3"/></spine></package>';
+  const nav=xh('Contents','<nav epub:type="toc"><ol><li><a href="ch1.xhtml">One: The Start</a></li><li><a href="ch2.xhtml">Two: The Middle</a></li><li><a href="ch3.xhtml">Three: The Long One</a></li></ol></nav>');
+  const z=zipStore([{name:'mimetype',data:'application/epub+zip'},{name:'META-INF/container.xml',data:'<?xml version="1.0"?><container version="1.0" xmlns="urn:oasis:names:tc:opendocument:xmlns:container"><rootfiles><rootfile full-path="OEBPS/content.opf" media-type="application/oebps-package+xml"/></rootfiles></container>'},{name:'OEBPS/content.opf',data:opf},{name:'OEBPS/nav.xhtml',data:nav},{name:'OEBPS/ch1.xhtml',data:ch1},{name:'OEBPS/ch2.xhtml',data:ch2},{name:'OEBPS/ch3.xhtml',data:ch3}]);
+  S.booksBeta=true;S.sel='books';render();return [...z]});
+ await p.waitForTimeout(500);
+ ck('Books row shows with the beta switch on',await p.evaluate(()=>!!document.querySelector('[data-sel="books"]')));
+ ck('the empty shelf offers to open a book file',await p.evaluate(()=>{const x=document.querySelector('#bkpick'),i=document.querySelector('#bkf');return !!x&&x.textContent.trim()==='Open a book file'&&!!i&&/epub/.test(i.accept)}));
+ await p.setInputFiles('#bkf',{name:'test.epub',mimeType:'application/epub+zip',buffer:Buffer.from(bytes)});
+ await p.waitForFunction(()=>BK.last&&/^b:/.test(S.sel)&&document.querySelector('[data-bkn]'),null,{timeout:20000}).catch(()=>{});
+ const m=await p.evaluate(async()=>{const l=await bkAll();const m=l[0];return m&&{n:l.length,id:m.id,title:m.title,author:m.author,parts:m.parts.map(x=>[x.t,x.w,x.s]),toc:m.toc,rows:document.querySelectorAll('#grid [data-bkn]').length,ttl:$('#ttl').textContent}});
+ ck('the book is stored with its title and author',m&&m.title==='A Test Voyage'&&m.author==='Ann Author',JSON.stringify(m&&[m.title,m.author]));
+ ck('the long chapter is split into two parts at paragraph breaks',m&&m.parts.length===4&&m.parts[2][2]===2&&m.parts[3][2]===2&&m.parts.every(x=>x[1]<=9000),JSON.stringify(m&&m.parts));
+ ck('the contents list shows the three chapters',m&&m.rows===3&&m.toc.map(x=>x.t).join('|')==='One: The Start|Two: The Middle|Three: The Long One',JSON.stringify(m&&m.toc));
+ const st=await p.evaluate(async id=>{const h=await bkTx('ch','readonly',s=>s.get(id+'/0'));return {script:/<script|onclick|<form|<iframe|<input/i.test(h),link:/data-bkh="1#end2"/.test(h)&&/href="#bk-end2"/.test(h),sup:/<sup>1<\/sup>/.test(h),ids:/id="bk-c1"/.test(h)}},m.id);
+ ck('the cleaner drops scripts, handlers, forms and frames',!st.script,JSON.stringify(st));
+ ck('it keeps footnote marks and rewrites links inside the book',st.link&&st.sup&&st.ids,JSON.stringify(st));
+ await p.click('[data-bkn="0"]');await p.waitForTimeout(2200);
+ const o=await p.evaluate(()=>({link:curA&&curA.link,np:R.np,pg:R.pg,vert:isVert(),folio:(document.querySelector('.book')||{dataset:{}}).dataset.folio||'',bad:window.__bad||0,why:!!document.querySelector('.cols .whyit'),orig:!!document.querySelector('.cols .orig'),text:/Chapter 1 paragraph 3/.test(document.querySelector('.cols .body').textContent),lang:document.querySelector('.cols .body').lang}));
+ ck('chapter 1 opens in the paged reader',o.link&&/^book:.+\/0$/.test(o.link)&&o.np>2&&!o.vert&&o.text,JSON.stringify(o));
+ ck('the folio reads book title · chapter · page',/^A Test Voyage · One: The Start\s+·\s+1$/.test(o.folio),o.folio);
+ ck('no script ran and no news extras (Why it matters, Read original)',!o.bad&&!o.why&&!o.orig,JSON.stringify(o));
+ ck('the book language reaches the text (hyphenation)',o.lang==='en',o.lang);
+ ck('a book link never goes to the network',await p.evaluate(async()=>(await getFull('book:x/0'))===null)&&!bookReq.length,JSON.stringify(bookReq));
