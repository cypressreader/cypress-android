<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the app's manifest at build time (see scripts/prepare_android.py). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets CyPress open Android's installer for its own updates. Android still asks you to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Gentle vibration (a soft tap on save, a tick on pull to refresh). Can be turned off in Settings. -->
    <uses-permission android:name="android.permission.VIBRATE" />


    <application android:usesCleartextTraffic="true">
        <provider
            android:name="com.cypress.reader.CyFileProvider"
            android:authorities="${applicationId}.cyfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cy_paths" />
        </provider>
    </application>
</manifest>
