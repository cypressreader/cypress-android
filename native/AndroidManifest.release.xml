<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the app's manifest at build time (see scripts/prepare_android.py). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets CyPress open Android's installer for its own updates. Android still asks you to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Optional: exact sunset time for the night theme. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application android:usesCleartextTraffic="true">
        <provider
            android:name="com.cypress.reader.CyFileProvider"
            android:authorities="${applicationId}.cyfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cy_paths" />
        </provider>
    </application>
</manifest>
