<?xml version="1.0" encoding="utf-8"?>
<!-- Headlines widget, first story: a big photo card with the headline over a fade (paper card when the story has no picture). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cy_wf_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="4dp"
    android:layout_weight="1.6"
    android:background="@drawable/cy_w_thumb_bg"
    android:minHeight="128dp">

    <ImageView
        android:id="@+id/cy_wf_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/cy_wf_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cy_w_scrim"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/cy_wf_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cy_w_photo_frame"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:minHeight="128dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/cy_wf_src"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textColor="@color/cy_w_brass"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/cy_wf_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:lineSpacingMultiplier="1.06"
            android:maxLines="3"
            android:paddingTop="3dp"
            android:textColor="@color/cy_w_photo_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
