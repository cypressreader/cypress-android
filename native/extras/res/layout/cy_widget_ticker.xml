<?xml version="1.0" encoding="utf-8"?>
<!-- Ticker: Clean full-bleed container with zero nested inner frames.
     Flips between breaking/latest headlines. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cy_w_bg"
    android:minHeight="48dp">

    <ViewFlipper
        android:id="@+id/cy_wk_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="6000"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out" />

    <TextView
        android:id="@+id/cy_wk_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="serif"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/cy_w_muted"
        android:textSize="14sp"
        android:textStyle="italic"
        android:visibility="gone" />
</FrameLayout>
