<?xml version="1.0" encoding="utf-8"?>
<!-- One story page in Ticker: Photo or antique brass sun fallback on the left, high-contrast kicker & headline on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cy_wq_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/cy_wq_img"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="12dp"
        android:background="@drawable/cy_w_thumb_bg"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <FrameLayout
        android:id="@+id/cy_wq_sun_box"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="12dp"
        android:background="@drawable/cy_w_forest_bg"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/cy_w_sun" />
    </FrameLayout>

    <ImageView
        android:id="@+id/cy_wq_bar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/cy_w_bar"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cy_wq_src"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textColor="@color/cy_w_kicker"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/cy_wq_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:lineSpacingMultiplier="1.08"
            android:maxLines="2"
            android:paddingTop="2dp"
            android:textColor="@color/cy_w_ink"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
