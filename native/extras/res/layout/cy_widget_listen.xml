<?xml version="1.0" encoding="utf-8"?>
<!-- Continue listening: the cover, what is playing and a play/pause button. Tapping the card opens CyPress. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cy_wl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cy_w_bg"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/cy_wl_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/cy_w_thumb_bg"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/cy_w_mark" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/cy_wl_kick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continue listening"
            android:textAllCaps="true"
            android:textColor="@color/cy_w_kicker"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cy_wl_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="2"
            android:text="The Daily"
            android:textColor="@color/cy_w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cy_wl_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/cy_w_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/cy_wl_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/cy_w_pill_bg"
        android:contentDescription="Play"
        android:scaleType="center"
        android:src="@drawable/cy_ic_play"
        android:tint="@color/cy_w_ink" />
</LinearLayout>
