<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed card item for AdapterViewFlipper in CyPress Top Story -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cy_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Full-bleed image state (fills 100% of widget canvas corner-to-corner) -->
    <ImageView
        android:id="@+id/cy_card_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Dark gradient scrim over lower 45% (transparent to #0c2619 forest green) -->
    <ImageView
        android:id="@+id/cy_card_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cy_w_scrim"
        android:importantForAccessibility="no" />

    <!-- 2. Fallback state: rich dark-forest card with antique brass sun ornament -->
    <FrameLayout
        android:id="@+id/cy_card_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cy_w_forest_bg"
        android:visibility="gone">

        <!-- Top sun ornament header with subtle brass rules -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/cy_w_brass"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/cy_card_sun"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/cy_w_sun" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/cy_w_brass"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </FrameLayout>

    <!-- Folio Pill (top-left) -->
    <TextView
        android:id="@+id/cy_card_folio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/cy_w_pill_bg"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.14"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="CYPRESS  ·  1 / 5"
        android:textColor="@color/cy_w_brass"
        android:textSize="9sp" />

    <!-- Editorial Story Content Block (bottom with generous breathing room) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/cy_card_bar"
            android:layout_width="28dp"
            android:layout_height="1.5dp"
            android:layout_marginBottom="7dp"
            android:background="@color/cy_w_brass"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/cy_card_src"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textColor="@color/cy_w_brass"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/cy_card_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="3"
            android:paddingTop="4dp"
            android:textColor="@color/cy_w_photo_text"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
