<?xml version="1.0" encoding="utf-8"?>
<!-- Swipeable card item for the Android StackView widget -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cy_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Full-bleed image state -->
    <ImageView
        android:id="@+id/cy_card_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/cy_card_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cy_w_scrim"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- 2. Editorial typographic fallback state (cream paper or forest card) -->
    <FrameLayout
        android:id="@+id/cy_card_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cy_w_bg"
        android:visibility="gone">

        <!-- Top sun ornament header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/cy_w_brass"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/cy_card_sun"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/cy_w_sun" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/cy_w_brass"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </FrameLayout>

    <!-- Inset brass border frame -->
    <ImageView
        android:id="@+id/cy_card_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        android:background="@drawable/cy_w_photo_frame"
        android:importantForAccessibility="no" />

    <!-- Editorial Folio Badge (top-left) -->
    <TextView
        android:id="@+id/cy_card_folio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/cy_w_pill_bg"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.14"
        android:maxLines="1"
        android:paddingStart="9dp"
        android:paddingTop="3.5dp"
        android:paddingEnd="9dp"
        android:paddingBottom="3.5dp"
        android:text="CYPRESS  ·  1 / 5"
        android:textColor="@color/cy_w_brass"
        android:textSize="8.5sp" />

    <!-- Editorial Story Content Block (bottom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/cy_card_bar"
            android:layout_width="26dp"
            android:layout_height="1.5dp"
            android:layout_marginBottom="6dp"
            android:background="@color/cy_w_brass"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/cy_card_src"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textColor="@color/cy_w_brass"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/cy_card_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:lineSpacingMultiplier="1.08"
            android:maxLines="3"
            android:paddingTop="4dp"
            android:textColor="@color/cy_w_photo_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
