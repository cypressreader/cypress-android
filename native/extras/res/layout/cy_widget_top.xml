<?xml version="1.0" encoding="utf-8"?>
<!-- A2: Top Story. Photo full-bleed with a fade, brass kicker, serif headline, counter and round chevrons.
     No photo: the cream (or forest) card with a brass hairline. The root is android:id/background so Android 12+ rounds it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cy_w_bg">

    <ImageView
        android:id="@+id/cy_wt_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/cy_wt_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cy_w_scrim"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/cy_wt_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        android:background="@drawable/cy_w_frame"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/cy_wt_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no"
            android:src="@drawable/cy_w_mark" />

        <TextView
            android:id="@+id/cy_wt_empty_t"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="@color/cy_w_muted"
            android:textSize="14sp"
            android:textStyle="italic" />
    </LinearLayout>

    <TextView
        android:id="@+id/cy_wt_upd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/cy_w_pill"
        android:letterSpacing="0.08"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="UPDATING…"
        android:textColor="@color/cy_w_photo_text"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cy_wt_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/cy_wt_src"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textColor="@color/cy_w_kicker"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/cy_wt_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="3"
            android:paddingTop="4dp"
            android:textColor="@color/cy_w_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cy_wt_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cy_wt_pos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="CYPRESS"
                android:textColor="@color/cy_w_muted"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/cy_wt_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:contentDescription="Previous story"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/cy_w_chev_prev" />

            <ImageButton
                android:id="@+id/cy_wt_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:contentDescription="Next story"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/cy_w_chev_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
