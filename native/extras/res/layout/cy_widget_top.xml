<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cy_wt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cy_w_top_bg">

    <TextView
        android:id="@+id/cy_wt_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="14dp"
        android:fontFamily="serif"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:text="1"
        android:textColor="@color/cy_wt_num"
        android:textSize="84sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cy_wt_upd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:text="Updating…"
        android:textColor="@color/cy_wt_sub"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cy_wt_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/cy_wt_src"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textColor="@color/cy_wt_kicker"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cy_wt_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="5"
            android:paddingTop="3dp"
            android:textColor="@color/cy_wt_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cy_wt_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cy_wt_pos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CyPress"
                android:textColor="@color/cy_wt_sub"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/cy_wt_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:contentDescription="Previous story"
                android:padding="12dp"
                android:src="@drawable/cy_w_ic_prev" />

            <ImageButton
                android:id="@+id/cy_wt_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:contentDescription="Next story"
                android:padding="12dp"
                android:src="@drawable/cy_w_ic_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
