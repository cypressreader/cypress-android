<?xml version="1.0" encoding="utf-8"?>
<!-- Top Story: a flipper that turns to the next story by itself every few seconds (each story is one page, see cy_widget_top_page).
     Two big round arrows sit top right. The root is android:id/background so Android 12+ rounds it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cy_w_bg">

    <ViewFlipper
        android:id="@+id/cy_wt_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="7000"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out" />

    <LinearLayout
        android:id="@+id/cy_wt_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no"
            android:src="@drawable/cy_w_mark" />

        <TextView
            android:id="@+id/cy_wt_empty_t"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="@color/cy_w_muted"
            android:textSize="14sp"
            android:textStyle="italic" />
    </LinearLayout>

    <TextView
        android:id="@+id/cy_wt_upd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/cy_w_pill"
        android:letterSpacing="0.08"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="UPDATING…"
        android:textColor="@color/cy_w_photo_text"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cy_wt_arrows"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/cy_wt_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="Previous story"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/cy_w_chev_prev" />

        <ImageButton
            android:id="@+id/cy_wt_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="Next story"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/cy_w_chev_next" />
    </LinearLayout>
</FrameLayout>
