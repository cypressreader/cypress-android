<?xml version="1.0" encoding="utf-8"?>
<!-- Top Story: a flipper that turns to the next story by itself every few seconds (each story is one page, see cy_widget_top_page).
     Two big round arrows sit top right. The root is android:id/background so Android 12+ rounds it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cy_w_bg">

    <StackView
        android:id="@+id/cy_stack_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true" />

    <LinearLayout
        android:id="@+id/cy_wt_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/cy_w_sun" />

        <TextView
            android:id="@+id/cy_wt_empty_t"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="@color/cy_w_muted"
            android:textSize="14sp"
            android:textStyle="italic" />
    </LinearLayout>

    <TextView
        android:id="@+id/cy_wt_upd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/cy_w_pill_bg"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="UPDATING…"
        android:textColor="@color/cy_w_brass"
        android:textSize="9sp"
        android:visibility="gone" />
</FrameLayout>
