<?xml version="1.0" encoding="utf-8"?>
<!-- 4x3 / 4x4 Magazine Spread:
     Top 60%: Cinematic full-bleed hero photograph with dark gradient scrim and serif typography.
     Bottom 40%: Warm cream card hosting two secondary story briefs with high-contrast timestamps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cy_w_bg"
    android:orientation="vertical">

    <!-- Top 60%: Cinematic Full-Bleed Hero -->
    <FrameLayout
        android:id="@+id/cy_wsp_hero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6">

        <!-- 1. Full-bleed hero photograph (edge-to-edge) -->
        <ImageView
            android:id="@+id/cy_wsp_hero_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- 2. Dark gradient scrim over lower 45% (transparent to #0c2619 forest green) -->
        <ImageView
            android:id="@+id/cy_wsp_hero_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cy_w_scrim"
            android:importantForAccessibility="no" />

        <!-- 3. Fallback state: rich dark-forest card with antique brass sun ornament -->
        <FrameLayout
            android:id="@+id/cy_wsp_hero_fallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cy_w_forest_bg"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/cy_w_brass"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/cy_wsp_hero_sun"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/cy_w_sun" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/cy_w_brass"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </FrameLayout>

        <!-- Brand / Edition Pill (top-left) -->
        <TextView
            android:id="@+id/cy_wsp_hero_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/cy_w_pill_bg"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:paddingStart="9dp"
            android:paddingTop="3.5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3.5dp"
            android:text="CYPRESS  ·  THE FRONT PAGE"
            android:textColor="@color/cy_w_brass"
            android:textSize="8.5sp" />

        <!-- Story text block at bottom of hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/cy_wsp_hero_src"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:textColor="@color/cy_w_brass"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/cy_wsp_hero_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.08"
                android:maxLines="3"
                android:paddingTop="3dp"
                android:textColor="@color/cy_w_photo_text"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Hairline rule separating hero from secondary briefs -->
    <ImageView
        android:id="@+id/cy_wsp_hrule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cy_w_rule"
        android:importantForAccessibility="no" />

    <!-- Bottom 40%: Warm Cream Card with Two Secondary Story Briefs -->
    <LinearLayout
        android:id="@+id/cy_wsp_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:background="@color/cy_w_paper"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <!-- Secondary Brief 1 (left column) -->
        <LinearLayout
            android:id="@+id/cy_wsp_b1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/cy_wsp_b1_src"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:textColor="@color/cy_w_kicker"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/cy_wsp_b1_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.08"
                android:maxLines="3"
                android:paddingTop="2dp"
                android:textColor="@color/cy_w_ink"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Vertical hairline divider between briefs -->
        <ImageView
            android:id="@+id/cy_wsp_vrule"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/cy_w_rule"
            android:importantForAccessibility="no" />

        <!-- Secondary Brief 2 (right column) -->
        <LinearLayout
            android:id="@+id/cy_wsp_b2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/cy_wsp_b2_src"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:textColor="@color/cy_w_kicker"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/cy_wsp_b2_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.08"
                android:maxLines="3"
                android:paddingTop="2dp"
                android:textColor="@color/cy_w_ink"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/cy_wl_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/cy_w_sun" />

        <TextView
            android:id="@+id/cy_wl_empty_t"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="@color/cy_w_muted"
            android:textSize="14sp"
            android:textStyle="italic" />
    </LinearLayout>
</LinearLayout>
