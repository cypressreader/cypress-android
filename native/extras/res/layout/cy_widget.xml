<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cy_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cy_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/cy_w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CyPress"
        android:textColor="#FFB9D9C3"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cy_w_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="6dp"
        android:textColor="#FFF3F1EA"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/cy_w_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="6dp"
        android:textColor="#FFF3F1EA"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/cy_w_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="6dp"
        android:textColor="#FFF3F1EA"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/cy_w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Open CyPress to load your headlines"
        android:textColor="#FFF3F1EA"
        android:textSize="14sp" />
</LinearLayout>
