<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cy_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cy_widget_bg"
    android:padding="8dp">

    <ViewFlipper
        android:id="@+id/cy_w_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="8000"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out" />

    <TextView
        android:id="@+id/cy_w_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:text="CyPress"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#CC000000"
        android:shadowRadius="4"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/cy_w_arrows"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/cy_w_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/cy_w_btn_bg"
            android:contentDescription="Previous story"
            android:src="@drawable/cy_ic_prev" />

        <ImageButton
            android:id="@+id/cy_w_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/cy_w_btn_bg"
            android:contentDescription="Next story"
            android:src="@drawable/cy_ic_next" />
    </LinearLayout>

    <TextView
        android:id="@+id/cy_w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="16dp"
        android:text="Open CyPress to load your headlines"
        android:textColor="#FFF3F1EA"
        android:textSize="14sp" />
</FrameLayout>
