<?xml version="1.0" encoding="utf-8"?>
<!-- The Daily: how far you are through this edition, the next unread story and a Read next button.
     Finished: a short "done" note and when the next edition arrives. Tapping anywhere opens the next story. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cy_w_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cy_wd_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="The Daily"
            android:textColor="@color/cy_w_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cy_wd_cnt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textColor="@color/cy_w_kicker"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/cy_wd_prog"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progressDrawable="@drawable/cy_w_prog" />

    <TextView
        android:id="@+id/cy_wd_kick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:textColor="@color/cy_w_kicker"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/cy_wd_head"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="2"
        android:paddingTop="2dp"
        android:textColor="@color/cy_w_ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/cy_wd_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cy_wd_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/cy_w_muted"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/cy_wd_go"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/cy_w_go_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="Read next"
            android:textColor="@color/cy_w_paper"
            android:textSize="13.5sp" />
    </LinearLayout>
</LinearLayout>
