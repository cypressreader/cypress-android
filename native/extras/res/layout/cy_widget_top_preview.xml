<?xml version="1.0" encoding="utf-8"?>
<!-- Preview for Top Story card deck in widget picker -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cy_w_bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cy_w_preview_photo"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cy_w_scrim"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/cy_w_pill_bg"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.14"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="CYPRESS  ·  1 / 5"
        android:textColor="@color/cy_w_brass"
        android:textSize="9sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/cy_w_pill_bg"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/cy_w_chev_prev" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/cy_w_pill_bg"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/cy_w_chev_next" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="1.5dp"
            android:layout_marginBottom="7dp"
            android:background="@color/cy_w_brass"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="ASTRONOMY  ·  2H"
            android:textColor="@color/cy_w_brass"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="3"
            android:paddingTop="4dp"
            android:text="A Rare Comet Makes Its Closest Approach in 80,000 Years"
            android:textColor="@color/cy_w_photo_text"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
