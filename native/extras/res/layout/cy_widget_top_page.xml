<?xml version="1.0" encoding="utf-8"?>
<!-- One story in the Top Story flipper: photo full-bleed with a fade, brass kicker, serif headline. No photo: the paper card with a brass hairline. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cy_wp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/cy_wp_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/cy_wp_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cy_w_scrim"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/cy_wp_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        android:background="@drawable/cy_w_frame"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/cy_wp_folio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="13dp"
        android:background="@drawable/cy_w_pill_bg"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.14"
        android:maxLines="1"
        android:paddingStart="9dp"
        android:paddingTop="3.5dp"
        android:paddingEnd="9dp"
        android:paddingBottom="3.5dp"
        android:text="CYPRESS  ·  1 / 5"
        android:textColor="@color/cy_w_brass"
        android:textSize="8.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/cy_wp_bar"
            android:layout_width="24dp"
            android:layout_height="1.5dp"
            android:layout_marginBottom="6dp"
            android:background="@color/cy_w_brass"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/cy_wp_src"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textColor="@color/cy_w_kicker"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/cy_wp_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:lineSpacingMultiplier="1.08"
            android:maxLines="3"
            android:paddingTop="4dp"
            android:textColor="@color/cy_w_ink"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
