<?xml version="1.0" encoding="utf-8"?>
<!-- D6: long-press the CyPress icon for these. Each opens MainActivity with a cy_open_url marker
     ("cypress:view:..."), which CyExtras.handleIntent passes to the web app (handleOpen in www/index.html).
     Added to MainActivity by scripts/prepare_android.py (meta-data android.app.shortcuts). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="cy_listen"
        android:enabled="true"
        android:icon="@drawable/cy_sc_play"
        android:shortcutShortLabel="@string/cy_sc_listen_short"
        android:shortcutLongLabel="@string/cy_sc_listen_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.cypress.reader"
            android:targetClass="com.cypress.reader.MainActivity">
            <extra android:name="cy_open_url" android:value="cypress:view:listen" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="cy_saved"
        android:enabled="true"
        android:icon="@drawable/cy_sc_saved"
        android:shortcutShortLabel="@string/cy_sc_saved_short"
        android:shortcutLongLabel="@string/cy_sc_saved_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.cypress.reader"
            android:targetClass="com.cypress.reader.MainActivity">
            <extra android:name="cy_open_url" android:value="cypress:view:saved" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="cy_search"
        android:enabled="true"
        android:icon="@drawable/cy_sc_search"
        android:shortcutShortLabel="@string/cy_sc_search_short"
        android:shortcutLongLabel="@string/cy_sc_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.cypress.reader"
            android:targetClass="com.cypress.reader.MainActivity">
            <extra android:name="cy_open_url" android:value="cypress:view:search" />
        </intent>
    </shortcut>
</shortcuts>
