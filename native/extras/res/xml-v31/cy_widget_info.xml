<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Expansive 4x3 by default, resizable up to 4x4, with live picker preview. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="600dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:description="@string/cy_widget_top_desc"
    android:initialLayout="@layout/cy_widget_top"
    android:previewImage="@drawable/cy_w_prev_top"
    android:previewLayout="@layout/cy_widget_top_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
