<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces AndroidManifest.release.xml when the optional extras are enabled
     (see scripts/prepare_android.py). Superset of the core overlay. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets CyPress open Android's installer for its own updates. Android still asks you to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Optional: exact sunset time for the night theme. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Extras: alerts, morning pack, reading aloud with lock-screen controls, vibration. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Lets CyPress find the phone's text-to-speech engine (needed on Android 11 and later). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application android:usesCleartextTraffic="true">
        <provider
            android:name="com.cypress.reader.CyFileProvider"
            android:authorities="${applicationId}.cyfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cy_paths" />
        </provider>

        <service
            android:name="com.cypress.reader.CyMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name="com.cypress.reader.CyWidgetProvider"
            android:exported="true"
            android:label="CyPress headlines">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cy_widget_info" />
        </receiver>
    </application>
</manifest>
