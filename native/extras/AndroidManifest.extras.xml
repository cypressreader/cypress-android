<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces AndroidManifest.release.xml when the optional extras are enabled
     (see scripts/prepare_android.py). Superset of the core overlay. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets CyPress open Android's installer for its own updates. Android still asks you to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Gentle vibration (a soft tap on save, a tick on pull to refresh). Can be turned off in Settings. -->
    <uses-permission android:name="android.permission.VIBRATE" />


    <!-- Extras: alerts, morning pack, reading aloud with lock-screen controls. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets CyPress find the phone's text-to-speech engine (needed on Android 11 and later). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application android:usesCleartextTraffic="true">
        <provider
            android:name="com.cypress.reader.CyFileProvider"
            android:authorities="${applicationId}.cyfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cy_paths" />
        </provider>

        <service
            android:name="com.cypress.reader.CyMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name="com.cypress.reader.CyBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.cypress.reader.CyWidgetProvider"
            android:exported="true"
            android:label="CyPress Top Story">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cy_widget_info" />
        </receiver>
        <receiver
            android:name="com.cypress.reader.CyWidgetListProvider"
            android:exported="true"
            android:label="CyPress Headlines">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cy_widget_info_list" />
        </receiver>
        <receiver
            android:name="com.cypress.reader.CyWidgetTickerProvider"
            android:exported="true"
            android:label="CyPress Ticker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cy_widget_info_ticker" />
        </receiver>
    </application>
</manifest>
